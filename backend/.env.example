PORT=5000

# ==============================================================================
# ENTERPRISE CAD ARCHITECTURE CONFIGURATION (7 PILLARS)
# ==============================================================================

# Pillar 1 & 2: Routing Engine & Live Traffic Data
# Default: OSRM (Open Source Routing Machine on OpenStreetMap road network, 100% free)
# Optional: Provide Mapbox token for traffic-aware ETAs and congestion heatmaps
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# Pillar 3: GPS Telematics (AVL Unit Ingestion)
# GPS coordinates can be pushed via POST /api/telematics/gps or native WebSockets
TELEMATICS_AUTH_TOKEN=cad-secure-telematics-token

# Pillar 4: WebSockets Live Push Layer
# Runs natively on /ws (e.g. ws://localhost:5000/ws)

# Pillar 5: Persistent State Store
# Default: Atomic file-backed store at backend/data/cad_store.json
# Optional: Redis connection URI for multi-instance horizontal scaling
REDIS_URL=

# Pillar 6: Municipal Emergency Vehicle Preemption (EVP) Gateway
# NTCIP 1202 & Opticom integration bridge with City Traffic Management Center (TMC)
MUNICIPAL_TMC_GATEWAY_URL=
MUNICIPAL_API_KEY=

# Pillar 7: Production AI Dispatch Generation & Hardening
# Optional: Provide Gemini or OpenAI key for external LLM dispatcher explanations
# If blank, built-in deterministic heuristic reasoning engine provides instant responses
GEMINI_API_KEY=
OPENAI_API_KEY=
CAD_JWT_SECRET=super-secure-production-jwt-secret
